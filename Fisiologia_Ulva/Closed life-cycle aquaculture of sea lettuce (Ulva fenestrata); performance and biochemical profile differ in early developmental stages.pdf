      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Closed life-cycle aquaculture of sea lettuce (Ulva fenestrata): performance and biochemical profile differ in early developmental stages</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Sophie Steinhagen; Karin Larsson; Joakim Olsson; Eva Albers; Ingrid Undeland; Henrik Pavia; Gunilla B. Toth</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Sea lettuce (Ulva) aquaculture has increased the last decade due to high productivity, wide environmental tolerance, and interesting functional and nutritional properties of the crop&#xA;on adult biomass production, but knowledge of performance and biochemical content of early developmental stages &amp;ndash; which are the basis to any large-scale production - is still limited&#xA;ory of Ulva alternates between a diploid sporophytic life-stage and a haplontic gametophytic life-stage</rdf:li>
            </rdf:Alt>
         </dc:description>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xapMM="http://ns.adobe.com/xap/1.0/mm/">
